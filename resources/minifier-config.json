{

    "fileExt": "html",
    "collapseWhitespace": true,
    "removeComments": true,
    "removeRedundantAttributes": true,
    "minifyCSS": true,
    "minifyJS": true,
    "sortAttributes": true,
    "sortClassName": true,
    "ignoreCustomFragments": ["<img[^>]+src=[\"']data:image\\/[^\"']+[\"'][^>]*>"]
}
